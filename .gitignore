# Deployment output
out/
plan/
*.plan.json
*.plan.md

# PowerShell / editor noise
*.log
.vscode/
.idea/

# Never commit credentials
*.pfx
*.pem
*.key
.env
secrets.json
# Squad: ignore runtime state (logs, inbox, sessions)
