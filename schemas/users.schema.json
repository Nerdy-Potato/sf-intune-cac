{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Nerdy-Potato/sf-intune-cac/schemas/users.schema.json",
  "title": "Accounts and age-tier placement",
  "type": "object",
  "additionalProperties": false,
  "required": ["users"],
  "properties": {
    "$schema": { "type": "string" },
    "comment": { "type": ["string", "array"] },
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "upnLocalPart", "domain", "accountType", "tier", "ageTierConfirmed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "displayName": { "type": "string", "minLength": 1 },
          "upnLocalPart": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "domain": { "type": "string", "enum": ["primary", "fallback"] },
          "accountType": { "type": "string", "enum": ["productivity", "admin", "firecall"] },
          "tier": { "type": "string", "enum": ["adult", "young-adult", "teen", "child", "admin", "excluded"] },
          "ageTierConfirmed": { "type": "boolean" }
        }
      }
    }
  }
}
