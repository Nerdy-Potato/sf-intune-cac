{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Nerdy-Potato/sf-intune-cac/schemas/tenant.schema.json",
  "title": "Tenant settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["displayName", "fallbackDomain", "environment", "managedMarker", "namePrefix", "safety"],
  "properties": {
    "$schema": { "type": "string" },
    "comment": { "type": ["string", "array"] },
    "displayName": { "type": "string", "minLength": 1 },
    "fallbackDomain": { "type": "string", "pattern": "^[a-z0-9-]+\\.onmicrosoft\\.com$" },
    "primaryDomain": { "type": ["string", "null"] },
    "environment": { "type": "string", "enum": ["production"] },
    "managedMarker": { "type": "string", "minLength": 10 },
    "namePrefix": { "type": "string", "minLength": 1 },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oneTime", "enabled", "groups", "apps"],
      "properties": {
        "oneTime": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "displayName", "securityEnabled", "mailEnabled", "groupTypes"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "displayName": { "type": "string", "minLength": 1 },
              "securityEnabled": { "type": "boolean" },
              "mailEnabled": { "type": "boolean" },
              "groupTypes": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "displayName", "odataType", "identity"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "displayName": { "type": "string", "minLength": 1 },
              "odataType": { "type": "string", "pattern": "^#microsoft\\.graph\\." },
              "identity": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value"],
                "properties": {
                  "kind": { "type": "string", "enum": ["packageId", "bundleId"] },
                  "value": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbidAllUsersAssignment", "forbidAllDevicesAssignment", "requireExplicitDeleteApproval"],
      "properties": {
        "forbidAllUsersAssignment": { "type": "boolean" },
        "forbidAllDevicesAssignment": { "type": "boolean" },
        "requireExplicitDeleteApproval": { "type": "boolean" }
      }
    }
  }
}
