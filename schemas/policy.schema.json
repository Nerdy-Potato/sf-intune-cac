{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Nerdy-Potato/sf-intune-cac/schemas/policy.schema.json",
  "title": "Intune policy definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "resource", "assignments", "payload"],
  "properties": {
    "$schema": { "type": "string" },
    "comment": { "type": ["string", "array"] },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "resource": {
      "type": "string",
      "enum": [
        "deviceCompliancePolicies",
        "deviceConfigurations",
        "iosManagedAppProtections",
        "androidManagedAppProtections"
      ]
    },
    "enabled": { "type": "boolean" },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mobileAppIdentifier"],
        "properties": {
          "mobileAppIdentifier": {
            "type": "object",
            "required": ["@odata.type"],
            "properties": { "@odata.type": { "type": "string" } }
          }
        }
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "intent"],
        "properties": {
          "group": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "enum": ["include", "exclude"] }
        }
      }
    },
    "payload": {
      "type": "object",
      "required": ["@odata.type", "displayName", "description"],
      "properties": {
        "@odata.type": { "type": "string", "pattern": "^#microsoft\\.graph\\." },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
