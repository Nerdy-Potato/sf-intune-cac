{
  "$schema": "../../../schemas/policy.schema.json",
  "comment": [
    "UNVERIFIED: settingDefinitionId strings in this payload are best-effort based on public",
    "Microsoft LAPS CSP documentation and have NOT been confirmed against a live tenant policy.",
    "Before this policy is deployed, create a test LAPS policy manually in the Intune portal and",
    "re-run scripts/bootstrap/Get-CaCConfigurationPolicyInventory.ps1 to capture and verify the",
    "real JSON, then update this file to match.",
    "Intent (per .squad/decisions/inbox/morpheus-laps-design-addendum.md): Windows LAPS baseline",
    "for all three device tiers. BackupDirectory = Microsoft Entra ID (AAD) only (no on-prem AD",
    "in this tenant); managed account name 'CaC-Support' rather than the built-in Administrator;",
    "password complexity set to the maximum CSP level (large letters + small letters + numbers",
    "+ special characters); password length 14 (Microsoft's documented minimum recommendation",
    "for the 'large letters + small letters + numbers + special characters' complexity tier);",
    "password age 30 days; post-authentication reset enabled so the password rotates immediately",
    "after an admin uses it interactively, not just on the fixed age schedule."
  ],
  "name": "laps-baseline",
  "resource": "deviceManagementConfigurationPolicies",
  "assignments": [
    { "group": "sg-devices-adult", "intent": "include" },
    { "group": "sg-devices-teen", "intent": "include" },
    { "group": "sg-devices-child", "intent": "include" }
  ],
  "payload": {
    "@odata.type": "#microsoft.graph.deviceManagementConfigurationPolicy",
    "displayName": "CaC - Windows LAPS Baseline",
    "description": "Managed by sf-intune-cac. Do not edit in the portal.",
    "platforms": "windows10",
    "technologies": "mdm",
    "settings": [
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationChoiceSettingInstance",
          "settingDefinitionId": "device_vendor_msft_laps_policies_backupdirectory",
          "choiceSettingValue": {
            "value": "device_vendor_msft_laps_policies_backupdirectory_1",
            "children": []
          }
        }
      },
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationSimpleSettingInstance",
          "settingDefinitionId": "device_vendor_msft_laps_policies_administratoraccountname",
          "simpleSettingValue": {
            "@odata.type": "#microsoft.graph.deviceManagementConfigurationStringSettingValue",
            "value": "CaC-Support"
          }
        }
      },
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationChoiceSettingInstance",
          "settingDefinitionId": "device_vendor_msft_laps_policies_passwordcomplexity",
          "choiceSettingValue": {
            "value": "device_vendor_msft_laps_policies_passwordcomplexity_4",
            "children": []
          }
        }
      },
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationSimpleSettingInstance",
          "settingDefinitionId": "device_vendor_msft_laps_policies_passwordlength",
          "simpleSettingValue": {
            "@odata.type": "#microsoft.graph.deviceManagementConfigurationIntegerSettingValue",
            "value": 14
          }
        }
      },
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationSimpleSettingInstance",
          "settingDefinitionId": "device_vendor_msft_laps_policies_passwordagedays",
          "simpleSettingValue": {
            "@odata.type": "#microsoft.graph.deviceManagementConfigurationIntegerSettingValue",
            "value": 30
          }
        }
      },
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationChoiceSettingInstance",
          "settingDefinitionId": "device_vendor_msft_laps_policies_postauthenticationactions",
          "choiceSettingValue": {
            "value": "device_vendor_msft_laps_policies_postauthenticationactions_3",
            "children": []
          }
        }
      }
    ]
  }
}
