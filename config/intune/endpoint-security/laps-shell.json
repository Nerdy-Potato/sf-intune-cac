{
  "$schema": "../../../schemas/policy.schema.json",
  "comment": [
    "Adopts the pre-existing, manually-created live Settings Catalog policy 'LAPS-Shell'",
    "(id 85cf4ba5-9bb4-4d0f-9e43-52f9e7d94d31 at adoption time; not stored here because",
    "matching is by displayName/name, never by id - see config/tenant.json's adoption.policies",
    "entry with id 'laps-shell'). payload.displayName below MUST exactly equal the live object's",
    "real name ('LAPS-Shell') for one-time adoption to match; do not rename it without updating",
    "tenant.json's adoption spec in lockstep.",
    "This Settings Catalog policy only configures LAPS to manage the named local admin password.",
    "It does NOT create x3nc0n by itself in default/manual LAPS mode. The companion",
    "laps-shell-automatic-account-management.json policy enables documented Windows LAPS Automatic",
    "Account Management so supported Windows 11 24H2+ devices create/manage that custom account.",
    "Live policy assignment was allDevices at inventory time; CaC narrows desired assignment to",
    "the explicit adult, teen, and child Windows device-tier groups to satisfy repository safety."
  ],
  "name": "laps-shell",
  "resource": "deviceManagementConfigurationPolicies",
  "assignments": [
    { "group": "sg-devices-adult", "intent": "include" },
    { "group": "sg-devices-teen", "intent": "include" },
    { "group": "sg-devices-child", "intent": "include" }
  ],
  "payload": {
    "@odata.type": "#microsoft.graph.deviceManagementConfigurationPolicy",
    "displayName": "LAPS-Shell",
    "description": "Managed by sf-intune-cac. Do not edit in the portal.",
    "platforms": "windows10",
    "technologies": "mdm",
    "settings": [
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationChoiceSettingInstance",
          "settingDefinitionId": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_enabled",
          "choiceSettingValue": {
            "value": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_enabled_1",
            "children": []
          }
        }
      },
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationChoiceSettingInstance",
          "settingDefinitionId": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_adminname",
          "choiceSettingValue": {
            "value": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_adminname_1",
            "children": [
              {
                "@odata.type": "#microsoft.graph.deviceManagementConfigurationSimpleSettingInstance",
                "settingDefinitionId": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_adminname_txt_adminaccountname",
                "simpleSettingValue": {
                  "@odata.type": "#microsoft.graph.deviceManagementConfigurationStringSettingValue",
                  "value": "x3nc0n"
