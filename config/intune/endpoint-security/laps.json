{
  "$schema": "../../../schemas/policy.schema.json",
  "comment": [
    "Freshly-authored (NOT adopted) Windows LAPS Settings Catalog policy. This is the real",
    "CaC-managed replacement for the manually-created 'LAPS-Shell' policy, which existed only",
    "so its live Graph JSON payload could be captured/inspected. Uses the same",
    "settingDefinitionIds/values reverse-engineered from that shell (enable LAPS, target account",
    "name x3nc0n, password age 30 days / complexity 4 (large letters + small letters + numbers +",
    "special chars) / length 14).",
    "Manual LAPS mode alone does not create custom local accounts - the companion",
    "laps-account-management.json policy (deviceConfigurations, documented LAPS",
    "CSP OMA-URI nodes) enables Windows LAPS Automatic Account Management so supported Windows 11",
    "24H2+ devices create/manage the x3nc0n account. That companion policy was independently",
    "authored (not adopted) and is unaffected by this change.",
    "Once this policy deploys cleanly via CI/CD, LAPS-Shell (the manually-created shell used only",
    "for JSON inspection) will be removed from both the tenant and this repo in a follow-up change."
  ],
  "name": "laps",
  "resource": "deviceManagementConfigurationPolicies",
  "assignments": [
    { "group": "sg-devices-adult", "intent": "include" },
    { "group": "sg-devices-teen", "intent": "include" },
    { "group": "sg-devices-child", "intent": "include" }
  ],
  "payload": {
    "@odata.type": "#microsoft.graph.deviceManagementConfigurationPolicy",
    "displayName": "CaC - Windows LAPS",
    "description": "Managed by sf-intune-cac. Do not edit in the portal.",
    "platforms": "windows10",
    "technologies": "mdm",
    "settings": [
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationChoiceSettingInstance",
          "settingDefinitionId": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_enabled",
          "choiceSettingValue": {
            "value": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_enabled_1",
            "children": []
          }
        }
      },
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationChoiceSettingInstance",
          "settingDefinitionId": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_adminname",
          "choiceSettingValue": {
            "value": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_adminname_1",
            "children": [
              {
                "@odata.type": "#microsoft.graph.deviceManagementConfigurationSimpleSettingInstance",
                "settingDefinitionId": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_adminname_txt_adminaccountname",
                "simpleSettingValue": {
                  "@odata.type": "#microsoft.graph.deviceManagementConfigurationStringSettingValue",
                  "value": "x3nc0n"
                }
              }
            ]
          }
        }
      },
      {
        "settingInstance": {
          "@odata.type": "#microsoft.graph.deviceManagementConfigurationChoiceSettingInstance",
          "settingDefinitionId": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd",
          "choiceSettingValue": {
            "value": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_1",
            "children": [
              {
                "@odata.type": "#microsoft.graph.deviceManagementConfigurationSimpleSettingInstance",
                "settingDefinitionId": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_elm_admpwd_passwordagedays",
                "simpleSettingValue": {
                  "@odata.type": "#microsoft.graph.deviceManagementConfigurationIntegerSettingValue",
                  "value": 30
                }
              },
              {
                "@odata.type": "#microsoft.graph.deviceManagementConfigurationChoiceSettingInstance",
                "settingDefinitionId": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_elm_admpwd_passwordcomplexity",
                "choiceSettingValue": {
                  "value": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_elm_admpwd_passwordcomplexity_4",
                  "children": []
                }
              },
              {
                "@odata.type": "#microsoft.graph.deviceManagementConfigurationSimpleSettingInstance",
                "settingDefinitionId": "device_vendor_msft_policy_config_admx_admpwd_pol_admpwd_elm_admpwd_passwordlength",
                "simpleSettingValue": {
                  "@odata.type": "#microsoft.graph.deviceManagementConfigurationIntegerSettingValue",
                  "value": 14
                }
              }
            ]
          }
        }
      }
    ]
  }
}
