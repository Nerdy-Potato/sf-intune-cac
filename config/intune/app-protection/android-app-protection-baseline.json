{
  "$schema": "../../../schemas/policy.schema.json",
  "comment": "Android counterpart of the iOS app protection baseline. Same posture, Android-specific controls. Included users come from the existing EveryoneButDad-SG dynamic group, not all productivity accounts, so John is outside MAM scope.",
  "name": "android-app-protection-baseline",
  "resource": "androidManagedAppProtections",
  "assignments": [{ "group": "sg-everyone-but-john", "intent": "include" }],
  "apps": [
    {
      "mobileAppIdentifier": {
        "@odata.type": "#microsoft.graph.androidMobileAppIdentifier",
        "packageId": "com.microsoft.office.outlook"
      }
    },
    {
      "mobileAppIdentifier": {
        "@odata.type": "#microsoft.graph.androidMobileAppIdentifier",
        "packageId": "com.microsoft.skydrive"
      }
    },
    {
      "mobileAppIdentifier": {
        "@odata.type": "#microsoft.graph.androidMobileAppIdentifier",
        "packageId": "com.microsoft.office.officehubrow"
      }
    },
    {
      "mobileAppIdentifier": {
        "@odata.type": "#microsoft.graph.androidMobileAppIdentifier",
        "packageId": "com.microsoft.office.word"
      }
    },
    {
      "mobileAppIdentifier": {
        "@odata.type": "#microsoft.graph.androidMobileAppIdentifier",
        "packageId": "com.microsoft.office.excel"
      }
    },
    {
      "mobileAppIdentifier": {
        "@odata.type": "#microsoft.graph.androidMobileAppIdentifier",
        "packageId": "com.microsoft.office.powerpoint"
      }
    },
    {
      "mobileAppIdentifier": {
        "@odata.type": "#microsoft.graph.androidMobileAppIdentifier",
        "packageId": "com.microsoft.office.onenote"
      }
    },
    {
      "mobileAppIdentifier": {
        "@odata.type": "#microsoft.graph.androidMobileAppIdentifier",
        "packageId": "com.microsoft.emmx"
      }
    },
    {
      "mobileAppIdentifier": {
        "@odata.type": "#microsoft.graph.androidMobileAppIdentifier",
        "packageId": "com.microsoft.teams"
      }
    }
  ],
  "payload": {
    "@odata.type": "#microsoft.graph.androidManagedAppProtection",
    "displayName": "CaC - Android - App Protection Baseline",
    "description": "Managed by sf-intune-cac. Do not edit in the portal.",
    "periodOfflineBeforeAccessCheck": "PT12H",
    "periodOnlineBeforeAccessCheck": "PT30M",
    "allowedInboundDataTransferSources": "allApps",
    "allowedOutboundDataTransferDestinations": "allApps",
    "allowedOutboundClipboardSharingLevel": "allApps",
    "organizationalCredentialsRequired": false,
    "dataBackupBlocked": false,
    "deviceComplianceRequired": false,
    "managedBrowserToOpenLinksRequired": false,
    "saveAsBlocked": false,
    "allowedDataStorageLocations": ["oneDriveForBusiness", "sharePoint", "box", "localStorage", "photoLibrary"],
    "periodOfflineBeforeWipeIsEnforced": "P90D",
    "pinRequired": false,
    "maximumPinRetries": 5,
    "simplePinBlocked": true,
    "minimumPinLength": 6,
    "pinCharacterSet": "numeric",
    "contactSyncBlocked": false,
    "printBlocked": false,
    "fingerprintBlocked": false,
    "screenCaptureBlocked": false,
    "disableAppEncryptionIfDeviceEncryptionIsEnabled": false,
    "encryptAppData": true
  }
}
