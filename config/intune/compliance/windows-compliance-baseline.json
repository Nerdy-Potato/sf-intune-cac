{
  "$schema": "../../../schemas/policy.schema.json",
  "comment": [
    "Security-only compliance floor for every human account, regardless of age.",
    "Grace periods are deliberately generous (notify immediately, block after 3 days) because a",
    "compliance block on a family tenant means somebody loses mail on their phone with no helpdesk."
  ],
  "name": "windows-compliance-baseline",
  "resource": "deviceCompliancePolicies",
  "assignments": [{ "group": "sg-productivity-all", "intent": "include" }],
  "payload": {
    "@odata.type": "#microsoft.graph.windows10CompliancePolicy",
    "displayName": "CaC - Windows - Compliance Baseline",
    "description": "Managed by sf-intune-cac. Do not edit in the portal.",
    "passwordRequired": true,
    "passwordBlockSimple": true,
    "passwordMinimumLength": 8,
    "passwordRequiredType": "alphanumeric",
    "passwordMinutesOfInactivityBeforeLock": 15,
    "passwordExpirationDays": null,
    "passwordPreviousPasswordBlockCount": 5,
    "requireHealthyDeviceReport": false,
    "osMinimumVersion": "10.0.19045.0",
    "earlyLaunchAntiMalwareDriverEnabled": false,
    "bitLockerEnabled": true,
    "secureBootEnabled": true,
    "codeIntegrityEnabled": true,
    "storageRequireEncryption": true,
    "activeFirewallRequired": true,
    "defenderEnabled": true,
    "rtpEnabled": true,
    "antivirusRequired": true,
    "antiSpywareRequired": true,
    "signatureOutOfDate": true,
    "deviceThreatProtectionEnabled": false,
    "scheduledActionsForRule": [
      {
        "ruleName": "PasswordRequired",
        "scheduledActionConfigurations": [
          {
            "actionType": "notification",
            "gracePeriodHours": 0,
            "notificationTemplateId": "",
            "notificationMessageCCList": []
          },
          {
            "actionType": "block",
            "gracePeriodHours": 72,
            "notificationTemplateId": "",
            "notificationMessageCCList": []
          }
        ]
      }
    ]
  }
}
