{
  "$schema": "../../../schemas/policy.schema.json",
  "comment": [
    "Strictest Windows tier (13 and under). The Store is blocked so that software arrives only",
    "through explicitly approved Intune app assignments, SmartScreen app-install control is on,",
    "and InPrivate browsing is blocked so that web filtering telemetry is meaningful."
  ],
  "name": "windows-restrictions-child",
  "resource": "deviceConfigurations",
  "assignments": [{ "group": "sg-tier-child", "intent": "include" }],
  "payload": {
    "@odata.type": "#microsoft.graph.windows10GeneralConfiguration",
    "displayName": "CaC - Windows - Device Restrictions (Child)",
    "description": "Managed by sf-intune-cac. Do not edit in the portal.",
    "windowsStoreBlocked": true,
    "appsAllowTrustedAppsSideloading": "blocked",
    "developerUnlockSetting": "blocked",
    "appsBlockWindowsStoreOriginatedApps": false,
    "smartScreenEnableAppInstallControl": true,
    "defenderBlockEndUserAccess": true,
    "defenderRequireRealTimeMonitoring": true,
    "defenderRequireBehaviorMonitoring": true,
    "defenderRequireNetworkInspectionSystem": true,
    "defenderScanDownloads": true,
    "defenderScanScriptsLoadedInInternetExplorer": true,
    "edgeRequireSmartScreen": true,
    "edgeBlockInPrivateBrowsing": true,
    "edgeBlockDeveloperTools": true,
    "edgeBlockExtensions": true,
    "edgeBlockPopups": true,
    "cortanaBlocked": true,
    "gameDvrBlocked": true,
    "privacyBlockInputPersonalization": true,
    "settingsBlockSystemPage": true,
    "settingsBlockDevicesPage": true,
    "storageRequireMobileDeviceEncryption": true,
    "bluetoothBlockAdvertising": true
  }
}
