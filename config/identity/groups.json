{
  "$schema": "../../schemas/groups.schema.json",
  "comment": [
    "Assignment groups. Membership is calculated from config/identity/users.json so that the",
    "tier a person sits in is the only thing anyone has to edit when a child gets older.",
    "Groups are assigned (static) rather than dynamic: dynamic rules would need attributes we",
    "deliberately do not store (age / date of birth), and static membership is far easier to review."
  ],
  "groups": [
    {
      "id": "sg-tier-adult",
      "displayName": "CaC-Tier-Adult",
      "mailNickname": "cac-tier-adult",
      "description": "Parents. Full privileges, security-only restrictions.",
      "purpose": "assignment",
      "membership": { "source": "tier", "values": ["adult"] }
    },
    {
      "id": "sg-tier-teen",
      "displayName": "CaC-Tier-Teen",
      "mailNickname": "cac-tier-teen",
      "description": "14-17. Security baseline plus light content controls; apps are blocklisted, not allowlisted.",
      "purpose": "assignment",
      "membership": { "source": "tier", "values": ["teen"] }
    },
    {
      "id": "sg-tier-child",
      "displayName": "CaC-Tier-Child",
      "mailNickname": "cac-tier-child",
      "description": "13 and under. Strictest tier: approved apps only, forced web filtering, tight device controls.",
      "purpose": "assignment",
      "membership": { "source": "tier", "values": ["child"] }
    },
    {
      "id": "sg-devices-adult",
      "displayName": "CaC-Devices-Adult",
      "mailNickname": "cac-devices-adult",
      "description": "Device group corresponding to the adult tier. Devices are assigned manually.",
      "purpose": "assignment",
      "memberType": "device",
      "membership": { "source": "explicit", "values": [] }
    },
    {
      "id": "sg-devices-teen",
      "displayName": "CaC-Devices-Teen",
      "mailNickname": "cac-devices-teen",
      "description": "Device group corresponding to the teen tier. Devices are assigned manually.",
      "purpose": "assignment",
      "memberType": "device",
      "membership": { "source": "explicit", "values": [] }
    },
    {
      "id": "sg-devices-child",
      "displayName": "CaC-Devices-Child",
      "mailNickname": "cac-devices-child",
      "description": "Device group corresponding to the child tier. Devices are assigned manually.",
      "purpose": "assignment",
      "memberType": "device",
      "membership": { "source": "explicit", "values": [] }
    },
    {
      "id": "sg-admins",
      "displayName": "CaC-Admins",
      "mailNickname": "cac-admins",
      "description": "Dedicated administrative accounts. Hardened, no productivity workloads.",
      "purpose": "assignment",
      "membership": { "source": "accountType", "values": ["admin"] }
    },
    {
      "id": "sg-productivity-all",
      "displayName": "CaC-Productivity-All",
      "mailNickname": "cac-productivity-all",
      "description": "Every human productivity account. Target for tier-independent security baselines.",
      "purpose": "assignment",
      "membership": { "source": "accountType", "values": ["productivity"] }
    },
    {
      "id": "sg-autopilot-device-preparation-child",
      "displayName": "CaC-Autopilot-DevicePreparation-Child",
      "mailNickname": "cac-autopilot-device-preparation-child",
      "description": "Assigned device group populated by Windows Autopilot device preparation for child devices.",
      "purpose": "assignment",
      "membership": { "source": "explicit", "values": [] }
    },
    {
      "id": "sg-breakglass",
      "displayName": "CaC-BreakGlass",
      "mailNickname": "cac-breakglass",
      "description": "Firecall accounts. Exclusion target only - never assign a policy to this group.",
      "purpose": "exclusion",
      "membership": { "source": "accountType", "values": ["firecall"] }
    }
  ]
}
